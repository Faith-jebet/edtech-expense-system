# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edtech_expense_control
DB_USER=expense_app_user
DB_PASSWORD=strong_password_here

# JWT Configuration
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@milestonetech.com

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,xls,xlsx

# Application Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
TIMEZONE=Africa/Nairobi

# Security
RATE_LIMIT_STORAGE_URL=memory://
SESSION_TIMEOUT_MINUTES=60

# Approval Configuration (defaults, can be overridden in DB)
DEFAULT_APPROVAL_SLA_DAYS=2
DEFAULT_PAYMENT_SLA_DAYS=3
DEFAULT_RECEIPT_SLA_DAYS=5
DEFAULT_ADVANCE_RETIREMENT_DAYS=14
PAYMENT_TOLERANCE_PERCENT=2.0

# Reconciliation
DEFAULT_RECONCILIATION_PERIOD=monthly

# Virus Scanning (placeholder)
ENABLE_VIRUS_SCAN=False
VIRUS_SCAN_COMMAND=

# Backup
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
